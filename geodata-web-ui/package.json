{
  "name": "geodata-web-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "空间数据管理控制台前端（GeoDataManage / geodata-service 8982）",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "test": "npm run test:datasets && npm run test:request-session && npm run test:tasks && npm run test:upload && npm run test:shell && npm run test:raster && npm run test:preview && npm run test:manage && npm run test:workspace && npm run test:integration",
    "test:datasets": "node scripts/test-datasets.mjs",
    "test:request-session": "node scripts/test-request-session.mjs",
    "test:tasks": "node scripts/test-task-domain.mjs && node scripts/test-task-center.mjs",
    "test:upload": "node scripts/test-upload-validation.mjs && node scripts/test-dataset-upload.mjs",
    "check": "npm run type-check && npm test && npm run build",
    "test:shell": "node scripts/test-shell.mjs",
    "test:raster": "node scripts/test-raster-page.mjs",
    "test:preview": "node scripts/test-resource-preview.mjs",
    "test:manage": "node scripts/test-manage-page.mjs",
    "test:workspace": "node scripts/test-workspace-tools.mjs",
    "test:integration": "node scripts/test-service-integration.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@microsoft/signalr": "^8.0.7",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "element-plus": "^2.10.2",
    "file-saver": "^2.0.5",
    "nprogress": "^0.2.0",
    "ol": "^10.5.0",
    "pako": "^2.1.0",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.4.1",
    "sm-crypto": "^0.5.7",
    "vue": "^3.5.17",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/nprogress": "^0.2.3",
    "@types/pako": "^2.0.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "typescript": "~5.8.0",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.5.0",
    "vite": "^6.2.4",
    "vue-tsc": "^2.2.8",
    "esbuild": "^0.25.12"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.25.12",
    "@rollup/rollup-win32-x64-msvc": "^4.64.4"
  }
}
