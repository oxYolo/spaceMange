<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>geodata-web</artifactId>
    <version>1.0.0</version>
    <name>geodata-web</name>
    <description>空间数据管理-Web 入口（启动类 + Controller + 配置，迁移自 dmsp-web）</description>

    <parent>
        <groupId>com.whulri</groupId>
        <artifactId>geodata-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>com.whulri</groupId>
            <artifactId>geodata-service</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 三维转换：核心框架 + 各语言工具链模块（运行期向 SPI 注册转换器 Bean） -->
        <dependency>
            <groupId>com.whulri</groupId>
            <artifactId>geodata-convert-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.whulri</groupId>
            <artifactId>geodata-convert-osgb</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.whulri</groupId>
            <artifactId>geodata-convert-pointcloud</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.whulri</groupId>
            <artifactId>geodata-convert-bim</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Web 基础 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- whulri 基座 -->
        <dependency>
            <groupId>com.whulri</groupId>
            <artifactId>whulri-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.whulri</groupId>
            <artifactId>whulri-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.whulri</groupId>
            <artifactId>whulri-common-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.whulri</groupId>
            <artifactId>whulri-common-swagger</artifactId>
        </dependency>
        <dependency>
            <groupId>com.whulri</groupId>
            <artifactId>whulri-common-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.whulri</groupId>
            <artifactId>whulri-common-datasource</artifactId>
        </dependency>
        <dependency>
            <groupId>com.whulri</groupId>
            <artifactId>whulri-common-datascope</artifactId>
        </dependency>

        <!-- 接口文档（Boot3 / OpenAPI3 / jakarta） -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <!-- Nacos（默认禁用，bootstrap.yml 中 enabled=false） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- 对象存储 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>

        <!-- spring-test（MockMultipartFile，FileUtil 使用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.whulri.geodata.GeodataApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
